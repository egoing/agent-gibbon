#!/bin/sh
# Run from any directory without cargo's build output contaminating JSON stdout.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
for binary in "$root/src-tauri/target/release/floatnote" "$root/src-tauri/target/debug/floatnote"; do
  if [ -x "$binary" ]; then exec "$binary" "$@"; fi
done
printf '%s\n' '{"ok":false,"error":"먼저 npm install && npm run build를 실행하세요"}'
exit 1
