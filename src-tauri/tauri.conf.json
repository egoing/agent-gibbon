{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Gibbon",
  "version": "0.2.7",
  "identifier": "org.egoing.floatnote",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Agent Gibbon",
        "width": 300,
        "height": 240,
        "minWidth": 144,
        "minHeight": 32,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "focus": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "acceptFirstMouse": true,
        "minimizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'none'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
