# Inject the public ingest DSN into the build process; never put an API management token here.
# .env files are NOT loaded automatically. Ordinary debug/test builds do not transmit.
AGENT_GIBBON_SENTRY_DSN=
# Explicit detailed diagnostics at runtime (also required for debug transmission).
AGENT_GIBBON_DIAGNOSTICS=0
# Set to off and restart to disable ALL collection, including release errors.
AGENT_GIBBON_TELEMETRY=
# Detailed mode: general traces; hot paths capped at 0.01, startup/probes always sampled.
AGENT_GIBBON_TRACE_SAMPLE_RATE=0.2

# A DSN or diagnostic flag never substitutes for in-app consent.
# Unfinished operator/storage/retention details keep all diagnostic sending off.
