{
  "name": "agent-gibbon",
  "version": "0.2.7",
  "private": true,
  "scripts": {
    "build": "tauri build --bundles app",
    "dev": "node scripts/dev.mjs dev",
    "check": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml && node --test tests/*.test.mjs",
    "build:release": "tauri build --bundles app,dmg",
    "dev:build": "node scripts/dev.mjs build",
    "dev:info": "node scripts/dev.mjs info"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  },
  "license": "MIT"
}
